# =========================
# Core
# =========================
AUTOPOSTER_DB_PATH=data/autoposter.sqlite3
AUTOPOSTER_QUEUE_DIR=queue
AUTOPOSTER_WORKER_INTERVAL_SECONDS=5
AUTOPOSTER_WORKER_BATCH_SIZE=25

# =========================
# Content Factory bridge
# =========================
# Bearer token used by Content Factory when sending content-package/1.0.
CONTENT_FACTORY_INGEST_TOKEN=

# Generated media is copied locally during ingest so delayed publishing never depends
# on an expiring presigned URL.
CONTENT_FACTORY_MEDIA_CACHE_DIR=data/content_factory_media
CONTENT_FACTORY_MEDIA_MAX_BYTES=26214400
# Optional comma-separated hostname allowlist, for example: cdn.example.com,s3.example.com
CONTENT_FACTORY_MEDIA_ALLOWED_HOSTS=

# Internal token for collectors/services that write publication performance snapshots
# into Autoposter. Empty means the performance-recording API is disabled.
AUTOPOSTER_ANALYTICS_INGEST_TOKEN=

# Content Factory callback endpoint and token. Example:
# CONTENT_FACTORY_PERFORMANCE_URL=http://content-factory-api:8000/performance/ingest
CONTENT_FACTORY_PERFORMANCE_URL=
CONTENT_FACTORY_PERFORMANCE_TOKEN=
CONTENT_FACTORY_FEEDBACK_BATCH_SIZE=50

# =========================
# Telegram
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_DEFAULT_DESTINATION=
TOKEN_WARNING_CHAT_ID=

# =========================
# YooKassa
# =========================
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
YOOKASSA_WEBHOOK_URL=
YOOKASSA_CURRENCY=RUB
YOOKASSA_TEST_MODE=false

# =========================
# VK
# =========================
VK_TOKEN=
VK_API_VERSION=5.199
VK_DEFAULT_OWNER_ID=
VK_TOKEN_OBTAINED_AT=
VK_TOKEN_EXPIRES_AT=
VK_TOKEN_LIFETIME_SECONDS=86400
VK_CLIENT_ID=
VK_REDIRECT_URI=https://oauth.vk.com/blank.html
VK_SCOPE=wall,photos,groups,offline

# =========================
# Instagram / Meta
# =========================
INSTAGRAM_GRAPH_API_VERSION=v22.0
INSTAGRAM_IG_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_TOKEN_EXPIRES_AT=
INSTAGRAM_TOKEN_LIFETIME_SECONDS=5183999
INSTAGRAM_PAGE_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://shakinartem.github.io/autoposter-site/callback
INSTAGRAM_SCOPE=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments,instagram_business_content_publish,instagram_business_manage_insights
INSTAGRAM_USERNAME=
INSTAGRAM_ACCOUNT_TYPE=BUSINESS

# =========================
# TikTok
# =========================
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_USERNAME=
TIKTOK_TOKEN_LIFETIME_SECONDS=86400
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_DEFAULT_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_DEFAULT_POST_MODE=DIRECT_POST
TIKTOK_DEFAULT_DISABLE_COMMENT=false
TIKTOK_DEFAULT_DISABLE_DUET=false
TIKTOK_DEFAULT_DISABLE_STITCH=false

# =========================
# Cloudinary
# =========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=autoposter

# =========================
# Optional token bookkeeping
# =========================
TIKTOK_TOKEN_OBTAINED_AT=
TIKTOK_TOKEN_EXPIRES_AT=
TIKTOK_REFRESH_TOKEN_EXPIRES_AT=
INSTAGRAM_TOKEN_OBTAINED_AT=
VK_TOKEN_OBTAINED_AT=
