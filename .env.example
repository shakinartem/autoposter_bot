# =========================
# Core
# =========================
# Absolute or relative path to SQLite database file.
AUTOPOSTER_DB_PATH=data/autoposter.sqlite3

# Legacy file queue path. The current bot mainly uses SQLite scheduling,
# but this path is still kept for compatibility with JSON job files.
AUTOPOSTER_QUEUE_DIR=queue


# =========================
# Telegram
# =========================
# Create bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Optional bot username without @, used for referral links.
TELEGRAM_BOT_USERNAME=

# Optional whitelist of Telegram user ids allowed to control admin bot.
# Example:
# TELEGRAM_ADMIN_USER_IDS=123456789,987654321
TELEGRAM_ADMIN_USER_IDS=

# Optional default destination if you want one global Telegram target.
# Usually account destinations are stored in SQLite instead.
# Examples:
# TELEGRAM_DEFAULT_DESTINATION=@my_channel
# TELEGRAM_DEFAULT_DESTINATION=-1001234567890
TELEGRAM_DEFAULT_DESTINATION=

# Chat/channel for operational warnings, for example VK token expiration reminders.
# If empty, bot falls back to TELEGRAM_DEFAULT_DESTINATION.
TOKEN_WARNING_CHAT_ID=


# =========================
# YooKassa
# =========================
# Shop identifier from YooKassa.
YOOKASSA_SHOP_ID=

# Secret key from YooKassa.
YOOKASSA_SECRET_KEY=

# Redirect URL after successful payment checkout.
YOOKASSA_RETURN_URL=

# Optional webhook endpoint if you plan to receive payment notifications.
YOOKASSA_WEBHOOK_URL=

# Currency for created payments.
YOOKASSA_CURRENCY=RUB

# Set true for sandbox/test mode.
YOOKASSA_TEST_MODE=false


# =========================
# VK
# =========================
# Access token with permissions required for wall/media publishing.
VK_TOKEN=

# VK API version used by the bot.
VK_API_VERSION=5.199

# Optional default owner_id if you want one global VK target.
# For groups it is usually negative, for example:
# VK_DEFAULT_OWNER_ID=-123456789
VK_DEFAULT_OWNER_ID=

# VK token lifetime tracking.
# Example:
# VK_TOKEN_OBTAINED_AT=2026-04-17T10:00:00
# VK_TOKEN_EXPIRES_AT=2026-04-18T10:00:00
VK_TOKEN_OBTAINED_AT=
VK_TOKEN_EXPIRES_AT=
VK_TOKEN_LIFETIME_SECONDS=86400
VK_CLIENT_ID=
VK_REDIRECT_URI=https://oauth.vk.com/blank.html
VK_SCOPE=wall,photos,groups,offline


# =========================
# Instagram / Meta
# =========================
# These values are usually stored per-account in SQLite options_json.
# They are duplicated here as a convenient source of truth/back-up.

# Instagram Graph API version.
INSTAGRAM_GRAPH_API_VERSION=v22.0

# Instagram Business/Creator account ID in Graph API.
INSTAGRAM_IG_USER_ID=

# Long-lived access token used to create/publish media containers.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_TOKEN_EXPIRES_AT=
INSTAGRAM_TOKEN_LIFETIME_SECONDS=5183999
# Optional but often useful while obtaining or refreshing access.
INSTAGRAM_PAGE_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://shakinartem.github.io/autoposter-site/callback
INSTAGRAM_SCOPE=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments,instagram_business_content_publish,instagram_business_manage_insights
# Optional metadata for your own tracking.
INSTAGRAM_USERNAME=
INSTAGRAM_ACCOUNT_TYPE=BUSINESS


# =========================
# TikTok
# =========================
# These values are usually stored per-account in SQLite options_json.
# They are duplicated here as a convenient source of truth/back-up.

# User access token for Content Posting API.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# Optional identifiers often returned by TikTok OAuth / account APIs.
TIKTOK_OPEN_ID=
TIKTOK_USERNAME=
TIKTOK_TOKEN_LIFETIME_SECONDS=86400

# Optional app credentials used outside the bot during OAuth/token refresh.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Defaults for TikTok posting behavior.
# Common values depend on account permissions. Examples:
# TIKTOK_DEFAULT_PRIVACY_LEVEL=SELF_ONLY
# TIKTOK_DEFAULT_POST_MODE=DIRECT_POST
TIKTOK_DEFAULT_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_DEFAULT_POST_MODE=DIRECT_POST
TIKTOK_DEFAULT_DISABLE_COMMENT=false
TIKTOK_DEFAULT_DISABLE_DUET=false
TIKTOK_DEFAULT_DISABLE_STITCH=false


# =========================
# Cloudinary
# =========================
# Used to upload local photo/video files and get public URLs for Instagram.
# For TikTok this is optional: TikTok can upload local videos directly,
# but Cloudinary URLs can also be used if you want.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=autoposter


# =========================
# SPGUtils Worker
# =========================
SPGUTILS_API_BASE_URL=https://api.spgutils.ru
SPGUTILS_API_TOKEN=
SPGUTILS_TIMEOUT_SECONDS=20


# =========================
# Optional token bookkeeping
# =========================
# Not used directly by current publishing code, but useful for your own ops.
TIKTOK_TOKEN_OBTAINED_AT=
TIKTOK_TOKEN_EXPIRES_AT=
TIKTOK_REFRESH_TOKEN_EXPIRES_AT=
INSTAGRAM_TOKEN_OBTAINED_AT=
VK_TOKEN_OBTAINED_AT=
