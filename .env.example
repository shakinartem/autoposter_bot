# =========================
# Core / persistence
# =========================
# SQLite development/legacy bridge.
AUTOPOSTER_DB_PATH=data/autoposter.sqlite3
AUTOPOSTER_QUEUE_DIR=queue

# Production PostgreSQL. Leave empty to use SQLite.
# AUTOPOSTER_DATABASE_URL=postgresql://autoposter:password@127.0.0.1:5432/autoposter
AUTOPOSTER_DATABASE_URL=

# Backend URL used by the Next.js server/BFF.
AUTOPOSTER_API_URL=http://127.0.0.1:8000
# Public web origin used by OAuth/login callbacks.
AUTOPOSTER_WEB_URL=http://localhost:3000


# =========================
# Workspace auth / encryption
# =========================
# Map trusted server API keys to exactly one workspace.
# Keys must be long random values. This is service/internal auth, not browser auth.
# AUTOPOSTER_API_KEYS_JSON={"replace-with-at-least-16-random-characters":1}
AUTOPOSTER_API_KEYS_JSON={}
AUTOPOSTER_REQUIRE_API_AUTH=1
AUTOPOSTER_DEV_WORKSPACE_ID=1

# Web BFF mode:
# - service: Next.js sends AUTOPOSTER_API_KEY from the server only
# - session: browser must have the HttpOnly autoposter_session cookie
AUTOPOSTER_WEB_AUTH_MODE=service
AUTOPOSTER_API_KEY=

# Generate Fernet keys, for example with Python cryptography Fernet.generate_key().
# Production PostgreSQL requires this key ring for encrypted social credentials.
# Multiple comma-separated keys allow rotation; newest key goes first.
AUTOPOSTER_CREDENTIAL_KEYS=
# Optional separate state keys; if empty, credential keys are reused.
AUTOPOSTER_OAUTH_STATE_KEYS=
AUTOPOSTER_LOGIN_STATE_KEYS=
AUTOPOSTER_OAUTH_STATE_TTL_SECONDS=600
AUTOPOSTER_LOGIN_STATE_TTL_SECONDS=600
AUTOPOSTER_LOGIN_GRANT_TTL_SECONDS=120
AUTOPOSTER_BROWSER_SESSION_TTL_SECONDS=2592000

# Private media upload/storage defaults.
AUTOPOSTER_MAX_UPLOAD_MB=512
# AUTOPOSTER_MEDIA_STORAGE=local or s3 depending on your deployment config.


# =========================
# Scheduled worker / reliability
# =========================
AUTOPOSTER_WORKER_INTERVAL_SECONDS=5
AUTOPOSTER_WORKER_BATCH_SIZE=25
# Explicitly retryable failures only. Unknown publish outcomes are terminal to
# avoid accidentally creating a duplicate remote post.
AUTOPOSTER_PUBLISH_MAX_ATTEMPTS=5
AUTOPOSTER_RETRY_BASE_SECONDS=60
AUTOPOSTER_RETRY_MAX_SECONDS=3600
AUTOPOSTER_RETRY_JITTER_RATIO=0.20


# =========================
# Telegram publishing / admin bot
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_DEFAULT_DESTINATION=
TOKEN_WARNING_CHAT_ID=


# =========================
# Telegram Web Login (OIDC)
# =========================
# Configure BotFather -> bot -> Login Widget/Web Login and register the exact
# website origin + callback URI before enabling session-mode public login.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Example production callback: https://api.example.com/auth/telegram/callback
TELEGRAM_OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/telegram/callback
TELEGRAM_OIDC_SCOPE=openid profile
# Telegram defaults to RS256. Only add another algorithm if you explicitly
# configured that signing algorithm in BotFather.
TELEGRAM_OIDC_ALLOWED_ALGORITHMS=RS256


# =========================
# YooKassa
# =========================
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
YOOKASSA_WEBHOOK_URL=
YOOKASSA_CURRENCY=RUB
YOOKASSA_TEST_MODE=false


# =========================
# VK
# =========================
VK_TOKEN=
VK_API_VERSION=5.199
VK_DEFAULT_OWNER_ID=
VK_TOKEN_OBTAINED_AT=
VK_TOKEN_EXPIRES_AT=
VK_TOKEN_LIFETIME_SECONDS=86400
VK_CLIENT_ID=
VK_REDIRECT_URI=https://oauth.vk.com/blank.html
VK_SCOPE=wall,photos,groups,offline


# =========================
# Instagram / Meta
# =========================
INSTAGRAM_GRAPH_API_VERSION=v22.0
INSTAGRAM_IG_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_TOKEN_EXPIRES_AT=
INSTAGRAM_TOKEN_LIFETIME_SECONDS=5183999
INSTAGRAM_PAGE_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match the redirect configured in the Instagram app.
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_SCOPE=instagram_business_basic,instagram_business_content_publish
INSTAGRAM_USERNAME=
INSTAGRAM_ACCOUNT_TYPE=BUSINESS


# =========================
# TikTok
# =========================
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_USERNAME=
TIKTOK_TOKEN_LIFETIME_SECONDS=86400
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match the Login Kit redirect configured for the TikTok app.
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPE=user.info.basic,video.publish,video.upload
TIKTOK_DEFAULT_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_DEFAULT_POST_MODE=DIRECT_POST
TIKTOK_DEFAULT_DISABLE_COMMENT=false
TIKTOK_DEFAULT_DISABLE_DUET=false
TIKTOK_DEFAULT_DISABLE_STITCH=false


# =========================
# Cloudinary legacy bridge
# =========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=autoposter


# =========================
# Optional token bookkeeping
# =========================
TIKTOK_TOKEN_OBTAINED_AT=
TIKTOK_TOKEN_EXPIRES_AT=
TIKTOK_REFRESH_TOKEN_EXPIRES_AT=
INSTAGRAM_TOKEN_OBTAINED_AT=
